#!/bin/bash
# Component ablation on the full VerilogEval set: AST cone only, and trace
# readings only. Together with the on/off arms from 2026-11-07 this
# separates what AST backtracking contributes from what re-presenting the
# trace contributes. Submit from mgmt01:
#
#     cd ~/rtlforge && qsub tools/ablation.pbs
#
#PBS -N rtlforge-ablate
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o ablation.pbs.out

cd "$HOME/rtlforge" || exit 1
exec > >(tee -a "$HOME/rtlforge/ablation.log") 2>&1
echo "=== $(date) on $(hostname)"
source tools/gpu_up.sh || { echo "gpu_up failed"; exit 1; }
python tools/patch_cone_into_loop.py
python tools/diagnose.py --preflight-only || { echo "preflight failed"; exit 1; }
TRIALS="${TRIALS:-3}"
python tools/diagnose.py --all --trials "$TRIALS" --evidence cone
python tools/diagnose.py --all --trials "$TRIALS" --evidence trace
echo "=== done $(date)"
kill "$OLLAMA_PID" 2>/dev/null   # only this job's server
